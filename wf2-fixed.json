{"updatedAt":"2026-10-09T10:57:00.000Z","createdAt":"2026-07-08T11:32:51.163Z","id":"tZwHDkw1PqSAYw1F","name":"2 - Callback Telegram → Assignation pharmacie","description":null,"active":true,"isArchived":false,"nodes":[{"id":"w2-webhook","name":"Webhook Callback","parameters":{"path":"telegram-callback","responseMode":"onReceived","options":{},"httpMethod":"POST"},"type":"n8n-nodes-base.webhook","position":[250,300],"typeVersion":1.1},{"id":"w2-parse","name":"Parser Callback","parameters":{"jsCode":"const body = $input.first().json.body;\n\nconst callbackData = body.callback_query?.data || '';\nconst chatId = body.callback_query?.from?.id;\nconst callbackQueryId = body.callback_query?.id;\n\nif (!callbackData || !chatId || !callbackQueryId) {\n  return [{ json: { error: 'Invalid callback data' } }];\n}\n\nconst parts = callbackData.split(':');\nif (parts[0] !== 'pick' || parts.length < 3) {\n  return [{ json: { error: 'Invalid callback format: ' + callbackData } }];\n}\n\nconst prescriptionId = parseInt(parts[1]);\nconst pharmacyId = parseInt(parts[2]);\n\nreturn [{ json: { prescriptionId, pharmacyId, chatId, callbackQueryId } }];"},"type":"n8n-nodes-base.code","position":[500,200],"typeVersion":1},{"id":"w2-get-pharmacy","name":"GET Pharmacy Name","parameters":{"method":"GET","url":"http://localhost:8081/api/pharmacies","options":{},"jsonParameters":true},"type":"n8n-nodes-base.httpRequest","position":[750,100],"typeVersion":4.1},{"id":"w2-assign","name":"Assign Pharmacy","parameters":{"method":"PUT","url":"http://localhost:8765/api/prescriptions/{{ $json.prescriptionId }}/assign-pharmacy","options":{},"jsonParameters":true,"bodyParametersJson":"={\n  \"pharmacyId\": {{ $json.pharmacyId }}\n}"},"type":"n8n-nodes-base.httpRequest","position":[1000,200],"typeVersion":4.1},{"id":"w2-answer-callback","name":"Answer Callback Query","parameters":{"method":"POST","url":"https://api.telegram.org/bot8644047281:AAHywXMMM9zpDThyBj_FOgme46RZi_GhzRk/answerCallbackQuery","options":{},"jsonParameters":true,"bodyParametersJson":"={\n  \"callback_query_id\": \"{{ $json.callbackQueryId }}\",\n  \"text\": \"✅ Pharmacie confirmée avec succès.\"\n}"},"type":"n8n-nodes-base.httpRequest","position":[1250,100],"typeVersion":4.1},{"id":"w2-send-confirm","name":"Send Confirmation","parameters":{"jsCode":"const pharmacyName = $input.item.json.pharmacyName || 'Pharmacie #' + $json.pharmacyId;\nconst prescriptionId = $json.prescriptionId;\n\nconst confirmText = '\\u2705 *Pharmacie confirmée*\\n\\n\\uD83C\\uDFE5 *' + pharmacyName + '* a bien \\u00E9t\\u00E9 sélectionnée pour votre ordonnance N\\u00B0' + prescriptionId + '.\\n\\n\\u23F3 Vous recevrez une notification dès que vos médicaments seront prêts.\\n\\n\\u2014\\n_MédiLink Tunisie \\u2013 Votre santé, notre priorité._';\n\nreturn [{ json: {\n  chatId: $json.chatId,\n  text: confirmText\n} }];"},"type":"n8n-nodes-base.code","position":[1000,300],"typeVersion":1},{"id":"w2-send-telegram","name":"Send Telegram Confirm","parameters":{"method":"POST","url":"https://api.telegram.org/bot8644047281:AAHywXMMM9zpDThyBj_FOgme46RZi_GhzRk/sendMessage","options":{},"jsonParameters":true,"bodyParametersJson":"={\n  \"chat_id\": \"{{ $json.chatId }}\",\n  \"text\": \"{{ $json.text }}\",\n  \"parse_mode\": \"Markdown\"\n}"},"type":"n8n-nodes-base.httpRequest","position":[1250,300],"typeVersion":4.1},{"id":"w2-respond","name":"Répondre","parameters":{"respondWith":"json","responseBody":"{}"},"type":"n8n-nodes-base.respondToWebhook","position":[1500,300],"typeVersion":1}],"connections":{"Webhook Callback":{"main":[[{"node":"Parser Callback","index":0}]]},"Parser Callback":{"main":[[{"node":"GET Pharmacy Name","index":0},{"node":"Assign Pharmacy","index":0}]]},"GET Pharmacy Name":{"main":[[{"node":"Send Confirmation","index":0}]]},"Assign Pharmacy":{"main":[[{"node":"Answer Callback Query","index":0}]]},"Answer Callback Query":{"main":[[{"node":"Répondre","index":0}]]},"Send Confirmation":{"main":[[{"node":"Send Telegram Confirm","index":0}]]},"Send Telegram Confirm":{"main":[[{"node":"Répondre","index":0}]]}},"settings":{},"staticData":null,"meta":{"templateCredsSetupCompleted":true},"pinData":{},"versionId":"e1232328-ead3-44de-96e9-a87ee71d2b94","activeVersionId":"e1232328-ead3-44de-96e9-a87ee71d2b94","versionCounter":36,"triggerCount":1,"tags":[],"shared":[]}