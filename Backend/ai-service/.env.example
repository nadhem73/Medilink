# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash
LLM_MAX_TOKENS=512
LLM_MAX_TOKENS_OCR=2048
LLM_TEMPERATURE=0.3

# Server
AI_SERVER_PORT=8092
AI_SERVER_HOST=0.0.0.0

# Eureka
EUREKA_SERVER=http://localhost:8761/eureka/
EUREKA_INSTANCE_HOST=localhost

# JWT (same as other services)
JWT_SECRET=medilinktunisia2025SecretKeyForJWTTokenGenerationAndValidation

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medilink_ai

# Vector DB
CHROMA_DB_PATH=./chroma_db

# API Gateway
API_GATEWAY_URL=http://localhost:8765/api
